# Copy to .env and fill in. Never commit .env.

#

# First-time backend + local LLM (from backend/ folder):

#   python bootstrap_llm.py

# (installs requirements.txt; downloads TinyLlama into chat/weights/local_llm/)



# --- Chat LLM (local transformers; no HF Inference API) ---

LLM_PROVIDER=local_mistral

# Preload chat model when Django starts (skips migrate/shell). Set false to speed up management commands only.
# LLM_EAGER_LOAD=false



# Hub id or pre-downloaded snapshot dir. Default is CPU-friendly TinyLlama chat.

LOCAL_MISTRAL_MODEL_ID=TinyLlama/TinyLlama-1.1B-Chat-v1.0

# Optional: override cache path (must contain config.json when using offline snapshot)

# LOCAL_MISTRAL_CACHE_DIR=



# Optional: HF token only for downloading gated weights (huggingface_hub), not for Inference API

# HF_TOKEN=



# Optional remote chat instead of local (set LLM_PROVIDER=groq)

# GROQ_API_KEY=

# OpenRouter — screen/video chunk AI analysis only (vision + content classification).
# OPENROUTER_API_KEY=
# OPENROUTER_REFERER=http://localhost:8000
# OPENROUTER_TITLE=MindSync
# OPENROUTER_VISION_MODEL=openrouter/auto
# OPENROUTER_CONTENT_MODEL=openai/gpt-4o-mini

# Google Gemini — Digital Psychologist chat only (POST /api/chat/). Not used for video.
# GEMINI_API_KEY=
# GEMINI_CHAT_MODEL=gemini-2.5-flash
# GEMINI_CHAT_MODEL_FALLBACKS=gemini-2.5-flash-lite,gemini-2.0-flash,gemini-2.0-flash-lite



# Generation (CPU: shorter + greedy = faster)

LLM_MAX_NEW_TOKENS=96

LLM_TEMPERATURE=0.7

# LLM_DO_SAMPLE=true   # slower, more varied; default false = greedy (faster on CPU)

# LLM_TOP_P=0.9

# --- Stripe (card payments via PaymentSheet) ---
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
